# shop2tax Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The install script (install.sh / install.ps1) does this for you and
# generates all secrets automatically. Lines starting with # are optional.

# ═══════════════════════════════════════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════════════════════════════════════
POSTGRES_USER=shop2tax
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=shop2tax

# ═══════════════════════════════════════════════════════════════════════════════
# Application
# ═══════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT=development
# DEBUG=false

# ═══════════════════════════════════════════════════════════════════════════════
# Network
# ═══════════════════════════════════════════════════════════════════════════════
# Host port and interface of the web UI. Loopback only by default.
# WEB_BIND=0.0.0.0 exposes the UI on the network — do that only with Google OAuth
# configured (Local Mode has no login).
# WEB_PORT=3002
# WEB_BIND=127.0.0.1

# ═══════════════════════════════════════════════════════════════════════════════
# Security (required only in Auth Mode — when Google OAuth is configured)
# ═══════════════════════════════════════════════════════════════════════════════
# Allow empty proxy secret in development (NEVER in production)
# ALLOW_INSECURE_PROXY_SECRET=false
# Shared secret between Nuxt and FastAPI (prevents direct API access)
# NUXT_PROXY_SECRET=generate-a-random-secret-here

# Session encryption (min 32 chars)
# SESSION_SECRET=generate-a-random-session-secret-min-32-chars

# ═══════════════════════════════════════════════════════════════════════════════
# Google OAuth (optional — omit for Local Mode, no login required)
# When set: Login page shown, session management active
# When omitted: App works immediately without authentication
# ═══════════════════════════════════════════════════════════════════════════════
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
#
# Login allowlist (REQUIRED in Auth Mode). Google authenticates ANY Google
# account, so you must restrict who may sign in. Comma-separated, case-insensitive.
# A login is accepted when the verified email matches ALLOWED_EMAILS or its domain
# (after '@') matches ALLOWED_EMAIL_DOMAINS. Set at least one — in Auth Mode EVERY
# login is denied until an allowlist is set (fail-closed / secure by default). The
# app still runs and logs a warning; nobody can sign in until you configure this.
# To deliberately allow ANY Google account (e.g. a public instance), set
# ALLOWED_EMAIL_DOMAINS=* as an explicit opt-in.
# ALLOWED_EMAILS=owner@example.com,accountant@example.com
# ALLOWED_EMAIL_DOMAINS=example.com

# ═══════════════════════════════════════════════════════════════════════════════
# PayPal API (optional, for PayPal transaction sync)
# ═══════════════════════════════════════════════════════════════════════════════
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_SANDBOX=false

# ═══════════════════════════════════════════════════════════════════════════════
# Billbee (optional, for invoice matching)
# ═══════════════════════════════════════════════════════════════════════════════
# BILLBEE_API_KEY=
# BILLBEE_USERNAME=
# BILLBEE_PASSWORD=
# BILLBEE_SYNC_LABEL=shop2tax

# ═══════════════════════════════════════════════════════════════════════════════
# Monitoring (optional)
# ═══════════════════════════════════════════════════════════════════════════════
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ═══════════════════════════════════════════════════════════════════════════════
# Storage Backend (receipt files)
# ═══════════════════════════════════════════════════════════════════════════════
# Required: 'gcs' (production) or 'local' (development)
STORAGE_BACKEND=local

# Local Storage (required when STORAGE_BACKEND=local, NOT for production)
# Files stored in Docker volume, no WORM protection
LOCAL_STORAGE_PATH=/data/receipts

# GCS (required when STORAGE_BACKEND=gcs)
# Bucket must have retention policy (3653 days) for GoBD compliance
# GCS_BUCKET_NAME=your-bucket-name
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Service Account Key (JSON file path) — use instead of gcloud auth for stable credentials
# Create: gcloud iam service-accounts keys create key.json --iam-account=SA@PROJECT.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_KEY=/path/to/service-account.json

# ═══════════════════════════════════════════════════════════════════════════════
# AI / OCR Provider (optional, for receipt text extraction via Vision-LLM)
# Only providers with a configured key appear in Settings → AI Provider dropdown
# ═══════════════════════════════════════════════════════════════════════════════
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# EXTRACTION_RATE_LIMIT=30/hour

# ═══════════════════════════════════════════════════════════════════════════════
# Nuxt (internal, usually no change needed)
# ═══════════════════════════════════════════════════════════════════════════════
# API_URL=http://api:8000

# ═══════════════════════════════════════════════════════════════════════════════
# Production only (docker-compose.prod.yml)
# ═══════════════════════════════════════════════════════════════════════════════
# DOMAIN=shop2tax.example.com
